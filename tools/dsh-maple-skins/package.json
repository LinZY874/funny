{
  "name": "dsh-maple-skins",
  "description": "MapleStory skin pack for the dsh web GUI: the original theme plus the three MapleStory 079 skin versions, served by a minimal switcher (Settings -> 冒险岛皮肤)",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "skins",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
